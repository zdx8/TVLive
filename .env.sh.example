#!/usr/bin/env bash
# =============================================================================
#  TVLive 项目环境加载脚本（template）
#  source 此脚本后用 ./gradlew 调用
#
#  实际路径请按你机器修改：
#    1. JAVA_HOME 指向 JDK 17（AGP 8.6+ 推荐 Temurin 17）
#    2. ANDROID_HOME / ANDROID_SDK_ROOT 指向你的 Android SDK
#    3. GRADLE_USER_HOME 可选；不设就 ~/.gradle
# =============================================================================

# JDK 17
export JAVA_HOME="/path/to/jdk-17"
export PATH="$JAVA_HOME/bin:$PATH"

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/emulator:$PATH"

# Gradle 用户主目录（默认 ~/.gradle；要换位置就在这里设）
# export GRADLE_USER_HOME="$HOME/.gradle"

# 让 ~/.android 写不进去时重定向
# export ANDROID_USER_HOME="$HOME/.android"

echo "✓ TVLive env loaded"
echo "  JAVA_HOME    = $JAVA_HOME"
echo "  ANDROID_HOME = $ANDROID_HOME"
java -version 2>&1 | head -1
