<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-row state list. D-pad focused rows get a bright left border
    and a subtle tint; selected (D-pad centre) gets a stronger tint.
    This is the visual cue TVs use instead of mouse hover.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2937" />
            <stroke android:width="4dp" android:color="#1976D2" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1F27" />
            <stroke android:width="3dp" android:color="#1976D2" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2937" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
