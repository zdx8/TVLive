<?xml version="1.0" encoding="utf-8"?>
<!--
    当前频道今日节目单（EPG）弹框：与 MENU / 退出框同一套半透明圆角视觉。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="600dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_exit_bg"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/epg_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="节目单"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/epg_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9C97A6"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_epg_refresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/dialog_menu_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="↻ 刷新"
            android:textColor="#FF8200"
            android:textSize="16sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/epg_schedule_list"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:divider="#26FFFFFF"
        android:dividerHeight="1dp"
        android:cacheColorHint="#00000000"
        android:listSelector="@drawable/drawer_row_background"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/epg_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:textColor="#9C97A6"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
